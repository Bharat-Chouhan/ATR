    "%matplotlib inline\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(16, 4.8))\n",
    "\n",
    "# Graph 1: Routing Precision Index (RQ1 & RQ2)\n",
    "categories = ['Orthogonal Tools', 'Confusable Cluster']\n",
    "base_rpi = [1.0000, 0.7467]\n",
    "soar_rpi = [1.0000, 0.8733]\n",
    "x = np.arange(len(categories))\n",
    "width = 0.35\n",
    "\n",
    "b1 = axes[0].bar(x - width/2, base_rpi, width, label='Baseline', color='#d9534f')\n",
    "b2 = axes[0].bar(x + width/2, soar_rpi, width, label='SOAR', color='#2b5c8f')\n",
    "axes[0].set_title('Routing Precision Index (RQ1 & RQ2)')\n",
    "axes[0].set_ylabel('Mean Rpi')\n",
    "axes[0].set_xticks(x)\n",
    "axes[0].set_xticklabels(categories)\n",
    "axes[0].set_ylim(0, 1.15)\n",
    "axes[0].grid(axis='y', alpha=0.3)\n",
    "axes[0].legend()\n",
    "for bar in b1 + b2:\n",
    "    axes[0].annotate(f'{bar.get_height():.4f}', (bar.get_x() + bar.get_width()/2, bar.get_height()),\n",
    "                     ha='center', va='bottom', fontsize=9)\n",
    "\n",
    "# Graph 2: Failure Mode Counts (Hallucination vs. Omission Trade-off)\n",
    "modes = ['R3 (Misclass.)', 'P2 (Omission)', 'P3 (Hallucination)']\n",
    "base_counts = [38, 162, 19]\n",
    "soar_counts = [19, 181, 0]\n",
    "x2 = np.arange(len(modes))\n",
    "\n",
    "f1 = axes[1].bar(x2 - width/2, base_counts, width, label='Baseline', color='#d9534f')\n",
    "f2 = axes[1].bar(x2 + width/2, soar_counts, width, label='SOAR', color='#2b5c8f')\n",
    "axes[1].set_title('Failure Taxonomy Distribution')\n",
    "axes[1].set_ylabel('Failure Count (500 Episodes)')\n",
    "axes[1].set_xticks(x2)\n",
    "axes[1].set_xticklabels(modes)\n",
    "axes[1].set_ylim(0, 210)\n",
    "axes[1].grid(axis='y', alpha=0.3)\n",
    "axes[1].legend()\n",
    "for bar in f1 + f2:\n",
    "    axes[1].annotate(f'{int(bar.get_height())}', (bar.get_x() + bar.get_width()/2, bar.get_height()),\n",
    "                     ha='center', va='bottom', fontsize=9)\n",
    "\n",
    "# Graph 3: Multi-Step Horizon Compounding Collapse (RQ3)\n",
    "horizons = [1, 2, 3, 5, 7, 10]\n",
    "q_step = 0.90\n",
    "theoretical_ql = [q_step ** L for L in horizons]\n",
    "empirical_tsr = [1.0, 1.0, 1.0, 1.0, 0.0, 0.0]\n",
    "\n",
    "axes[2].plot(horizons, theoretical_ql, 'o--', label='Theoretical Max ($q^L, q=0.90$)', color='gray')\n",
    "axes[2].plot(horizons, empirical_tsr, 's-', label='Empirical TSR (Base & SOAR)', color='#1f77b4', linewidth=2.5)\n",
    "axes[2].axvline(x=6, color='red', linestyle=':', label='Collapse Threshold ($L \\\\geq 7$)')\n",
    "axes[2].set_title('Horizon Compounding Collapse (RQ3)')\n",
    "axes[2].set_xlabel('Trace Length (L)')\n",
    "axes[2].set_ylabel('Trace Success Rate (TSR)')\n",
    "axes[2].set_ylim(-0.05, 1.15)\n",
    "axes[2].grid(True, alpha=0.3)\n",
    "axes[2].legend(fontsize=8.5)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
