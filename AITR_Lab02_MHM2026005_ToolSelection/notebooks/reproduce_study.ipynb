    "# AITR Lab 02: Evaluating Tool-Selection Accuracy in Multi-Tool Agentic AI\n",
    "**Author**: Bharat Chouhan (MHM2026005)  \n",
    "**Topic ID**: 12  \n",
    "\n",
    "This interactive notebook reproduces the key experimental findings:\n",
    "1. **Worked Numerical Example Verification (Section 5.7)**\n",
    "2. **Catalogue Semantic Overlap Degradation (RQ1 & RQ2)**\n",
    "3. **Horizon Compounding Error Collapse (RQ3)**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_rpi(actual_tools, pred_tools):\n",
    "    set_a, set_p = set(actual_tools), set(pred_tools)\n",
    "    return len(set_a & set_p) / len(set_a | set_p) if (set_a | set_p) else 1.0\n",
    "\n",
    "def compute_ajm(actual_args, pred_args):\n",
    "    keys_a, keys_p = set(actual_args.keys()), set(pred_args.keys())\n",
    "    union_keys = keys_a | keys_p\n",
    "    if not union_keys:\n",
    "        return 1.0\n",
    "    matches = sum(1 for k in (keys_a & keys_p) if actual_args[k] == pred_args[k])\n",
    "    return matches / len(union_keys)\n",
    "\n",
    "def compute_sf(actual_tools, pred_tools):\n",
    "    max_len = max(len(actual_tools), len(pred_tools))\n",
    "    if max_len == 0:\n",
    "        return 1.0\n",
    "    dp = [[0] * (len(pred_tools) + 1) for _ in range(len(actual_tools) + 1)]\n",
    "    for i in range(len(actual_tools) + 1):\n",
    "        dp[i][0] = i\n",
    "    for j in range(len(pred_tools) + 1):\n",
    "        dp[0][j] = j\n",
    "    for i in range(1, len(actual_tools) + 1):\n",
    "        for j in range(1, len(pred_tools) + 1):\n",
    "            cost = 0 if actual_tools[i - 1] == pred_tools[j - 1] else 1\n",
    "            dp[i][j] = min(dp[i - 1][j] + 1, dp[i][j - 1] + 1, dp[i - 1][j - 1] + cost)\n",
    "    return 1.0 - (dp[-1][-1] / max_len)\n",
    "\n",
    "def compute_composite(rpi, ajm, sf, w1=0.4, w2=0.4, w3=0.2):\n",
    "    return (w1 * rpi) + (w2 * ajm) + (w3 * sf)\n",
    "\n",
    "def classify_failures(actual_tools, pred_tools, actual_args, pred_args):\n",
    "    failures = []\n",
    "    if set(pred_tools) - set(actual_tools):\n",
    "        failures.append(\"R3\" if len(actual_tools) == len(pred_tools) else \"R1\")\n",
    "    for k, v in actual_args.items():\n",
    "        if k not in pred_args:\n",
    "            failures.append(\"P2\")\n",
    "        elif pred_args[k] != v:\n",
    "            failures.append(\"P3\")\n",
    "    if actual_tools != pred_tools:\n",
    "        failures.append(\"S1\")\n",
    "    return sorted(list(set(failures)))\n",
    "\n",
    "# Step 1: Verify Section 5.7 Worked Example\n",
    "A = [\"get_user_id\", \"get_balance\", \"send_report\"]\n",
    "P = [\"get_user_id\", \"get_balance\", \"send_email\"]\n",
    "rpi = compute_rpi(A, P)\n",
    "ajm = compute_ajm({\"user_id\": \"U1\", \"currency\": \"USD\"}, {\"user_id\": \"U1\", \"currency\": \"EUR_HALL\", \"region\": \"US\"})\n",
    "sf = compute_sf(A, P)\n",
    "comp = compute_composite(rpi, ajm, sf, 0.4, 0.4, 0.2)\n",
    "\n",
    "print(f\"Rpi: {rpi:.4f} (Expected 0.5000)\")\n",
    "print(f\"Ajm: {ajm:.4f} (Expected 0.3333)\")\n",
    "print(f\"Sf : {sf:.4f} (Expected 0.6667)\")\n",
    "print(f\"Composite C: {comp:.4f} (Expected ~0.47)\")"
   ]
  },
